# Flixy environment template — copy to .env.local (gitignored) and fill in real values.
# Never commit real secrets. The committed file documents the keys, not the values.

# --- Supabase ---
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- BetterAuth ---
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# --- Third-party catalogue / availability ---
TMDB_API_KEY=
TMDB_READ_ACCESS_TOKEN=
WATCHMODE_API_KEY=
# OMDb (free tier: 1000 req/day) — enrichment for IMDb rating/votes/awards
OMDB_API_KEY=
# Trakt (https://trakt.tv/oauth/applications) — trending watcher signal
TRAKT_CLIENT_ID=

# --- Catalogue ingest (server-side workers + edge function) ---
# Long random token shared between pg_cron (Vault) and edge functions.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# --- Email ---
RESEND_API_KEY=

# --- LLM (Phase 2+) ---
OPENROUTER_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Observability ---
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.posthog.com

# --- EAS / Expo (set in `eas.json` profiles, not here, except for local dev) ---
EXPO_PROJECT_ID=
